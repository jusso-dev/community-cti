# Local defaults only. Do not put production secrets in this file.
DATABASE_URL=postgres://cti:cti@localhost:5432/cti
DATABASE_APP_URL=postgres://cti_app:cti_app@localhost:5432/cti
OPENSEARCH_URL=http://localhost:9200
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 32 zero bytes, base64. Replace outside local development. Production uses a KMS-wrapped key.
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Leave empty unless a residency exception has been approved. See docs/DATA-GOVERNANCE.md.
XAI_API_KEY=
PORT=8080
